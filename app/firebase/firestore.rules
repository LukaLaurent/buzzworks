rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isNum(v) { return v is number && v >= 0; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isBanned() { return signedIn() && exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /gifts/{uid}/items/{id} {
      allow read, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
    }

    match /feedmeta/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && !isBanned()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && (resource == null || request.time > resource.data.last + duration.value(15, 'm'));
    }

    match /feedback/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['uid', 'n', 'l', 'kind', 'txt', 'v', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['bug', 'idea']
        && request.resource.data.txt is string && request.resource.data.txt.size() >= 10 && request.resource.data.txt.size() <= 600
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 18
        && request.resource.data.l is int && request.resource.data.l >= 1 && request.resource.data.l < 100000
        && request.resource.data.v is string && request.resource.data.v.size() <= 12
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/feedmeta/$(request.auth.uid)).data.last == request.time;
    }

    match /boss/{day}/scores/{uid} {
      function slotStart() {
        let p = day.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(int(p[3]), 'h');
      }
      function scoreOk(d) {
        return d.keys().hasOnly(['n', 'p', 'l', 'at'])
          && d.n is string && d.n.size() > 0 && d.n.size() <= 18
          && !d.n.matches('(?si).*(<|>|https?:|www[.]).*')
          && d.p is number && d.p >= 0 && d.p < 1000000000000000000000000000000.0
          && d.l is int && d.l >= 1 && d.l < 100000
          && d.at is number;
      }
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && !isBanned()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(00|04|08|12|16|20)$')
        && request.time >= slotStart()
        && request.time < slotStart() + duration.value(255, 'm')
        && scoreOk(request.resource.data)
        && (resource == null || request.resource.data.p >= resource.data.p);
    }

    match /saves/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    match /players/{uid} {
      allow read: if true;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid && !isBanned()
        && request.resource.data.keys().hasOnly(['name', 'tier', 'v', 'honey', 'crowns', 'essence', 'bees', 'level', 'trophies', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 18
        && isNum(request.resource.data.honey)
        && isNum(request.resource.data.crowns) && request.resource.data.crowns < 100000
        && isNum(request.resource.data.essence) && request.resource.data.essence < 10000000
        && isNum(request.resource.data.bees) && request.resource.data.bees <= 40
        && isNum(request.resource.data.level) && request.resource.data.level < 100000
        && isNum(request.resource.data.trophies) && request.resource.data.trophies <= 5000
        && request.resource.data.tier is int && request.resource.data.tier >= 0 && request.resource.data.tier <= 7;
    }

    match /groups/{gid} {
      function entryOk(e) {
        return e.keys().hasOnly(['n', 'p', 'l'])
          && e.n is string && e.n.size() > 0 && e.n.size() <= 18
          && e.p is number && e.p >= 0 && e.p < 1000000
          && e.l is number && e.l >= 1;
      }
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['week', 'tier', 'scores'])
        && request.resource.data.scores.keys().hasOnly([request.auth.uid])
        && entryOk(request.resource.data.scores[request.auth.uid]);
      allow update: if signedIn() && !isBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores'])
        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.scores.size() <= 20
        && entryOk(request.resource.data.scores[request.auth.uid])
        && (!(request.auth.uid in resource.data.scores)
            || request.resource.data.scores[request.auth.uid].p <= resource.data.scores[request.auth.uid].p + 20000);
    }
  }
}
