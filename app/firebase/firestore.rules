rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isNum(v) { return v is number && v >= 0; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isBanned() { return signedIn() && exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /gifts/{uid}/items/{id} {
      allow read, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
    }

    match /battles/{id} {
      function party() { return signedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b); }
      function same(k) { return request.resource.data[k] == resource.data[k]; }
      function scoreOk(v) { return v is map && v.keys().hasOnly(['c', 'h', 'f']) && v.c is number && v.c >= 0 && v.c < 100000 && v.h is number && v.h >= 0 && v.f is bool; }
      function liveTime() { return resource.data.status == 'live' && request.time.toMillis() < resource.data.end + 180000; }
      allow read: if party() || isAdmin();
      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['a', 'an', 'b', 'bn', 'stake', 'askin', 'status', 'at'])
        && request.resource.data.a == request.auth.uid
        && request.resource.data.b is string && request.resource.data.b != request.auth.uid
        && request.resource.data.status == 'invite';
      allow update: if party() && same('a') && same('b') && same('stake') && same('at') && (
        (request.auth.uid == resource.data.a
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sa', 'status'])
          && ((same('status') && liveTime() && scoreOk(request.resource.data.sa))
              || (resource.data.status == 'invite' && request.resource.data.status == 'cancelled')))
        || (request.auth.uid == resource.data.b
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sb', 'status', 'start', 'end', 'bskin'])
          && ((same('status') && liveTime() && scoreOk(request.resource.data.sb))
              || (resource.data.status == 'invite' && request.resource.data.status in ['live', 'declined'] && request.time.toMillis() < resource.data.at + 300000)))
      );
      allow delete: if isAdmin();
    }

    match /saves/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    match /players/{uid} {
      allow read: if true;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid && !isBanned()
        && request.resource.data.keys().hasOnly(['name', 'tier', 'v', 'honey', 'crowns', 'essence', 'bees', 'level', 'trophies', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 18
        && isNum(request.resource.data.honey)
        && isNum(request.resource.data.crowns) && request.resource.data.crowns < 100000
        && isNum(request.resource.data.essence) && request.resource.data.essence < 10000000
        && isNum(request.resource.data.bees) && request.resource.data.bees <= 40
        && isNum(request.resource.data.level) && request.resource.data.level < 100000
        && isNum(request.resource.data.trophies) && request.resource.data.trophies <= 5000
        && request.resource.data.tier is int && request.resource.data.tier >= 0 && request.resource.data.tier <= 7;
    }

    match /groups/{gid} {
      function entryOk(e) {
        return e.keys().hasOnly(['n', 'p', 'l'])
          && e.n is string && e.n.size() > 0 && e.n.size() <= 18
          && e.p is number && e.p >= 0 && e.p < 1000000
          && e.l is number && e.l >= 1;
      }
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['week', 'tier', 'scores'])
        && request.resource.data.scores.keys().hasOnly([request.auth.uid])
        && entryOk(request.resource.data.scores[request.auth.uid]);
      allow update: if signedIn() && !isBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores'])
        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.scores.size() <= 20
        && entryOk(request.resource.data.scores[request.auth.uid])
        && (!(request.auth.uid in resource.data.scores)
            || request.resource.data.scores[request.auth.uid].p <= resource.data.scores[request.auth.uid].p + 20000);
    }
  }
}
